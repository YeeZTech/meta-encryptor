{
    "name": "@yeez-tech/meta-encryptor",
    "version": "5.0.4",
    "description": "Data Seal/Unseal for Fidelius",
    "main": "build/commonjs/index.node.cjs",
    "module": "build/es/index.node.js",
    "types": "index.node.d.ts",
    "exports": {
        ".": {
            "browser": {
                "types": "./index.browser.d.ts",
                "import": "./build/es/index.browser.js"
            },
            "node": {
                "types": "./index.node.d.ts",
                "import": "./build/es/index.node.js",
                "require": "./build/commonjs/index.node.cjs"
            },
            "types": "./index.node.d.ts",
            "default": "./build/es/index.node.js"
        },
        "./browser": {
            "types": "./index.browser.d.ts",
            "import": "./build/es/index.browser.js"
        },
        "./node": {
            "types": "./index.node.d.ts",
            "import": "./build/es/index.node.js",
            "require": "./build/commonjs/index.node.cjs"
        }
    },
    "type": "module",
    "files": [
        "build",
        "*.d.ts",
        "README.md",
        "README.en.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node scripts/clean-build.mjs && rollup -c",
        "test:clean": "node scripts/cleanup-test-artifacts.cjs",
        "test:node": "jest --config jest.config.node.cjs",
        "test:browser": "npm run build && npm run gen:fixtures && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.browser.mjs",
        "gen:fixtures": "node --experimental-vm-modules scripts/generate-fixtures.mjs && node --experimental-vm-modules scripts/generate-browser-unsealer-fixture.mjs",
        "test": "npm run test:node && npm run test:browser",
        "test:stress": "jest --config jest.config.node.cjs --runInBand --testNamePattern=large",
        "typecheck": "tsc --noEmit -p tsconfig.types.json",
        "verify:pack": "node scripts/verify-package.mjs",
        "security:audit": "npm audit --omit=dev --audit-level=moderate",
        "serve:example": "node example/http/static-server.js",
        "gen:sealed": "node example/http/gen-sealed-stream.js",
        "version": "changeset version && npm install --package-lock-only --ignore-scripts",
        "release": "changeset publish"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/YeeZTech/meta-encryptor.git"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@babel/preset-env": "^7.28.5",
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.29.8",
        "@jest/transform": "^30.2.0",
        "@rollup/plugin-babel": "^6.1.0",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "axios": "^1.13.2",
        "babel-jest": "^30.2.0",
        "babel-loader": "^10.0.0",
        "bytebuffer": "^5.0.1",
        "csv-parser": "^3.2.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "rollup": "^4.54.0",
        "rollup-plugin-polyfill-node": "^0.13.0",
        "typescript": "^5.9.3",
        "uuidv7": "^1.1.0"
    },
    "author": "contact@yeez.tech",
    "license": "MIT",
    "dependencies": {
        "@types/node": "^24.0.0",
        "aes-js": "4.0.0-beta.5",
        "buffer": "^6.0.3",
        "core-js": "^3.47.0",
        "@noble/hashes": "^1.7.1",
        "loglevel": "^1.9.2",
        "memory-streams": "^0.1.3",
        "secp256k1": "^5.0.1"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "streamsaver": "^2.0.0"
    },
    "peerDependenciesMeta": {
        "streamsaver": {
            "optional": true
        }
    },
    "engines": {
        "node": "^18.0.0 || >= 18.0.0"
    }
}
